# Copy to .env (gitignored) and fill in. First name found wins.
#
# Your own key from dev.2gis.com (Directions API) -- what you want long term.
TWOGIS_ROUTING_KEY=

# Also accepted, in this order, for compatibility with the Next.js app that
# used to live in this repo:
# TWOGIS_API_KEY=
# 2GIS_API_KEY=

# Running on 2gis.kz's own front-end key instead? It works, and it is slow to
# rotate (observed alive over at least three months), but it is not yours: the
# quota is shared with all of 2gis.kz's traffic, and it can change without
# notice. Check liveness with `python scripts/check_key.py` and expect to
# refresh this value by hand when that starts exiting 3.
